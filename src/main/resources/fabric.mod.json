{
  "schemaVersion": 1,
  "id": "austrianpainter",
  "version": "${version}",
  "name": "Austrian Painter",
  "description": "Client-side cosmetic block painting. Repaints blocks with another block's textures while keeping their original shape, collision and behaviour.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/austrianpainter/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "com.maxisch.client.AustrianpainterDataGenerator"
    ],
    "client": [
      "com.maxisch.client.AustrianpainterClient"
    ],
    "modmenu": [
      "com.maxisch.client.ApModMenu"
    ]
  },
  "mixins": [
    "austrianpainter.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "yet_another_config_lib_v3": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
